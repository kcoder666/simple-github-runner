# Copy to .env and fill in your values. Do NOT commit .env.

# --- Dashboard ---
# Password for the web dashboard (and `Authorization: Bearer <password>` for the API).
ADMIN_PASSWORD=<choose-a-strong-password>
# Host port for the dashboard (default 8080).
# DASHBOARD_PORT=8080
# Set to true when serving the dashboard over HTTPS (marks the session cookie Secure).
# COOKIE_SECURE=true

# --- GitHub credentials: pick ONE ---
#
# Option A (recommended): a GitHub App. Installation tokens are minted on demand
# and never expire, so there is no monthly credential rotation to forget.
#   Repo runners: Repository permission "Administration: Read and write"
#   Org runners:  Organization permission "Self-hosted runners: Read and write"
#   Install the App on every org/account whose repos you add as targets.
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem   # or GITHUB_APP_PRIVATE_KEY="-----BEGIN..."
#
# Option B: a Personal Access Token.
#   Repo runners: fine-grained PAT with "Administration: Read and write" on the repos
#   Org runners:  classic PAT with "manage_runners:org" (or fine-grained org "Self-hosted runners: RW")
# The dashboard shows the PAT's expiry date and alerts before it expires.
GITHUB_PAT=<github-pat>

# --- Optional: instant scale-up (and scale-from-zero) via webhook ---
# Add a webhook on the repo/org -> http(s)://<controller>/webhook/github,
# content type application/json, event "Workflow jobs", with this secret.
# GITHUB_WEBHOOK_SECRET=<random-string>

# --- Optional ---
# PUBLIC_URL=https://gh-runners.example.com     # linked from alert notifications
# GITHUB_API_URL=https://api.github.com        # GitHub Enterprise Server: https://<host>/api/v3
# RUNNER_IMAGE=custom-github-runner:latest
# RUNNER_NAME_PREFIX=ghr                        # change if two controllers share a host or org
# LOG_LEVEL=INFO

# --- Migration from the compose-profile setup ---
# On first boot these become targets (min idle 1, max 4); afterwards manage
# targets in the dashboard. Safe to delete once imported.
# ORG_URL=https://github.com/<org>
# REPO_URL_1=https://github.com/<owner>/<repo_a>
# REPO_URL_2=https://github.com/<owner>/<repo_b>
